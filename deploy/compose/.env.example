BOOTSTRAP_OWNER_PASSWORD=change-me-now
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true
MIGRATE_ON_START=true
APP_BASE_URL=https://localhost
NEXT_PUBLIC_APP_BASE_URL=https://localhost
