# Hostname used by Caddy. Use localhost for a single-machine evaluation.
APP_HOST=localhost
APP_BASE_URL=https://localhost

# Pin a released image tag for production installs. latest is convenient for trials.
DEPLENS_VERSION=latest
DEPLENS_API_IMAGE=ghcr.io/ferretsecurity/deplens-platform-api
DEPLENS_WEB_IMAGE=ghcr.io/ferretsecurity/deplens-platform-web

# Replace these before running a real deployment.
POSTGRES_PASSWORD=change-me-db-password
BOOTSTRAP_OWNER_EMAIL=admin@example.com
BOOTSTRAP_OWNER_PASSWORD=change-me-now
