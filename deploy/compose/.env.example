APP_HOST=localhost
API_DATABASE_URL=postgres://postgres:postgres@postgres:5432/deplens?sslmode=disable
HTTP_ADDRESS=:8080
DEPLOYMENT_MODE=self-hosted
BLOB_BACKEND=filesystem
BLOB_FILESYSTEM_ROOT=/var/lib/deplens/blobs
